rules_version = '2';
// Security rules for the Beit HaMidrash forum.
// Roles live in users/{uid}.role: "user" | "mod" | "admin". The owner (OWNER_EMAIL) is always an admin,
// so the first admin exists before anyone has been promoted.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() { return signedIn() && request.auth.token.email == "OWNER_EMAIL" && request.auth.token.email_verified == true; }
    function isAdmin() { return isOwner() || (hasProfile() && me().role == "admin"); }
    function isMod() { return isAdmin() || (hasProfile() && me().role == "mod"); }
    function active() { return isOwner() || (hasProfile() && me().banned != true); }
    function moderated() {
      return !exists(/databases/$(database)/documents/settings/forum)
        || get(/databases/$(database)/documents/settings/forum).data.moderation != false;
    }
    // what a new thread or reply starts as: moderators publish directly, others wait for approval when moderation is on
    function newStatusOk(s) { return isMod() ? s in ["ok", "pending"] : s == (moderated() ? "pending" : "ok"); }
    function text(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "photo", "role", "banned", "created"])
        && text(request.resource.data.name, 2, 40)
        && request.resource.data.role == (isOwner() ? "admin" : "user") && request.resource.data.banned == false
        && request.resource.data.created == request.time;
      // people edit their own display name; moderators ban; only admins change roles
      allow update: if (request.auth.uid == uid && onlyChanged(["name", "photo"]) && text(request.resource.data.name, 2, 40))
        || (isMod() && onlyChanged(["banned"]) && resource.data.role == "user")
        || (isAdmin() && onlyChanged(["role", "banned"]) && request.resource.data.role in ["user", "mod", "admin"]);
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /threads/{id} {
      allow read: if resource.data.status == "ok" || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if active()
        && request.resource.data.keys().hasOnly(["cat", "title", "body", "uid", "author", "created", "last", "replies", "status", "pinned", "locked"])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.title, 3, 150) && text(request.resource.data.body, 1, 10000)
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.cat))
        && request.resource.data.created == request.time && request.resource.data.last == request.time
        && request.resource.data.replies == 0 && request.resource.data.pinned == false && request.resource.data.locked == false
        && newStatusOk(request.resource.data.status);
      allow update: if isMod()
        // the author edits the text while the thread is open
        || (active() && resource.data.uid == request.auth.uid && !resource.data.locked
            && onlyChanged(["title", "body", "edited"]) && request.resource.data.edited == request.time
            && text(request.resource.data.title, 3, 150) && text(request.resource.data.body, 1, 10000))
        // anyone replying moves the thread up and counts the reply
        || (active() && resource.data.status == "ok" && !resource.data.locked && onlyChanged(["replies", "last"])
            && request.resource.data.replies == resource.data.replies + 1 && request.resource.data.last == request.time);
      allow delete: if isMod() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.replies == 0);
    }

    match /posts/{id} {
      allow read: if resource.data.status == "ok" || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if active()
        && request.resource.data.keys().hasOnly(["thread", "body", "uid", "author", "created", "status"])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.body, 1, 10000)
        && request.resource.data.created == request.time
        && get(/databases/$(database)/documents/threads/$(request.resource.data.thread)).data.locked == false
        && newStatusOk(request.resource.data.status);
      allow update: if isMod()
        || (active() && resource.data.uid == request.auth.uid && onlyChanged(["body", "edited"])
            && request.resource.data.edited == request.time && text(request.resource.data.body, 1, 10000));
      allow delete: if isMod() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /reports/{id} {
      allow read, delete: if isMod();
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["thread", "post", "reason", "uid", "created"])
        && text(request.resource.data.reason, 2, 500) && request.resource.data.created == request.time;
    }
  }
}
